<Window x:Class="AionTranslator.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="译文悬浮窗" Height="430" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border x:Name="Shell" Background="#E6141B2B" CornerRadius="10" Padding="8,8,8,4"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="OverlayScroll" Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OverlayScroll_ScrollChanged">
                <ItemsControl x:Name="OverlayList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="2,3">
                                <Run Text="{Binding SpeakerTag, Mode=OneWay}" Foreground="{Binding OverlaySpeakerBrush, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="{Binding Translation, Mode=OneWay}" Foreground="#FFFF87B5"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="ManualStrip" Grid.Row="1" Margin="0,6,0,0" Background="#22FFFFFF" CornerRadius="6" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel x:Name="QuickBar" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                               Margin="0,0,0,6" Visibility="Collapsed"/>
                    <TextBox x:Name="ManualInput" Grid.Row="1" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Padding="6"
                             Background="#33FFFFFF" Foreground="White" BorderThickness="0" CaretBrush="White"
                             InputMethod.IsInputMethodEnabled="True"/>
                    <ComboBox x:Name="LangBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="6,0,0,0" FontSize="12"/>

                    <TextBox x:Name="ManualOutput" Grid.Row="2" Grid.Column="0" Height="56" Margin="0,6,0,0" Padding="6"
                             TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             Background="#22FFFFFF" Foreground="#FFFF87B5" BorderThickness="0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,6,0,0">
                        <Button x:Name="TranslateButton" Content="翻译" Height="26"
                                Click="ManualTranslate_Click" Background="#33FFFFFF" Foreground="White" BorderThickness="0"/>
                        <Button x:Name="SendButton" Content="发送" Height="26" Margin="0,4,0,0"
                                Click="ManualSend_Click" ToolTip="把这段译文直接打进游戏聊天并发出去"
                                Background="#33FFFFFF" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>