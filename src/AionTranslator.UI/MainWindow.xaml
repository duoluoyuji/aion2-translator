<Window x:Class="AionTranslator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AION2 实时翻译 · @吃素的佩奇" Height="700" Width="600"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Background="#FFF6F7FB">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="AION2 实时翻译" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FF1E2A44"/>
            <TextBlock x:Name="StatusText" Text="未开始" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#FF68748F" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ChannelBox" Grid.Column="0" Height="30" SelectedIndex="10" VerticalContentAlignment="Center">
                <ComboBoxItem Content="一般"/>
                <ComboBoxItem Content="呐喊"/>
                <ComboBoxItem Content="种族"/>
                <ComboBoxItem Content="军团"/>
                <ComboBoxItem Content="小队"/>
                <ComboBoxItem Content="副本"/>
                <ComboBoxItem Content="部队"/>
                <ComboBoxItem Content="部队通知"/>
                <ComboBoxItem Content="悄悄话"/>
                <ComboBoxItem Content="活动"/>
                <ComboBoxItem Content="全部"/>
            </ComboBox>
            <Button x:Name="StartButton" Grid.Column="1" Content="开始翻译" Height="30" Margin="8,0,0,0" Click="StartButton_Click" Background="#FF2F6BFF" Foreground="White" BorderThickness="0"/>
            <Button Grid.Column="3" Content="悬浮窗" Height="30" Padding="10,0" Click="OverlayButton_Click"/>
            <Button Grid.Column="4" Content="清空" Height="30" Margin="8,0,0,0" Padding="10,0" Click="ClearButton_Click"/>
            <Button Grid.Column="5" Content="设置" Height="30" Margin="8,0,0,0" Padding="10,0" Click="SettingsButton_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="2">
            <ListBox x:Name="ChatList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Margin="6,4">
                            <Run Text="{Binding SpeakerTag, Mode=OneWay}" Foreground="{Binding SpeakerBrush, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="{Binding Translation, Mode=OneWay}" Foreground="#FFD6336C"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>