<Window x:Class="AionTranslator.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="800" Width="560" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="13" Background="#FFF6F7FB">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="590">
            <StackPanel>
                <Border Background="#FFFFFFFF" CornerRadius="8" Padding="12" BorderBrush="#FFE3E8F2" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="翻译通道" FontWeight="SemiBold" Foreground="#FF2F3B56"/>
                        <TextBlock Text="聊天和悬浮窗手动翻译都走这一条。默认 B站公共接口：免 Key、中翻外也通。哪天它挂了，在下拉里换硅基流动/DeepSeek 等，填上 Key 即可。"
                                   Foreground="#FF8A93A8" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <ComboBox x:Name="ProviderBox" Height="28" SelectionChanged="ProviderBox_SelectionChanged"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="BaseUrlBox" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Padding="6"/>
                            <TextBox x:Name="ModelBox" Grid.Column="1" Height="28" Margin="8,0,0,0" VerticalContentAlignment="Center" Padding="6"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="KeyBox" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Padding="6" FontFamily="Consolas"/>
                            <Button Grid.Column="1" Content="获取Key" Height="28" Padding="10,0" Margin="8,0,0,0" Click="GetKeyButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="测试通道" Height="28" Padding="14,0" Click="TestButton_Click" Background="#FF2F6BFF" Foreground="White" BorderThickness="0"/>
                    <TextBlock x:Name="TestResultText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FF4C5872" FontSize="12" TextWrapping="Wrap" MaxWidth="260"/>
                </StackPanel>

                <TextBlock Text="游戏聊天翻译语言（默认简体中文）" Foreground="#FF68748F" Margin="0,12,0,4"/>
                <ComboBox x:Name="LanguageBox" Height="28"/>

                <TextBlock Text="悬浮窗背景浓淡（越往右越不透明，方便压在游戏画面上看清）" Foreground="#FF68748F" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="20" Maximum="95" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpacityText" Grid.Column="1" Foreground="#FF68748F" VerticalAlignment="Center" Width="44" TextAlignment="Right"/>
                </Grid>

                <TextBlock Text="悬浮窗字号" Foreground="#FF68748F" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Slider x:Name="FontSlider" Grid.Column="0" Minimum="12" Maximum="30" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FontText" Grid.Column="1" Foreground="#FF68748F" VerticalAlignment="Center" Width="44" TextAlignment="Right"/>
                </Grid>


            <CheckBox x:Name="ClickThroughBox" Content="鼠标穿透（按 F9 打开手动翻译条时会自动临时取消）" Margin="0,8,0,0"/>
                <CheckBox x:Name="ImeCompatBox" Content="输入法兼容模式（第三方输入法打不进字时勾选）" Margin="0,8,0,0"/>



                <CheckBox x:Name="NoiseChannelsBox" Margin="0,10,0,0"
                          Content="也翻译 NPC / 系统 / 战斗记录频道（默认不翻，省额度）"/>
                <CheckBox x:Name="OneKeySendBox" Margin="0,10,0,0"
                          Content="一键发送（仅支持英文输入，需要聊天窗口打开输入）"/>

                <TextBlock Text="启动时只翻译最近多少条历史（0 = 不翻历史，只翻启动后的新消息）" Foreground="#FF68748F" Margin="0,12,0,4"/>
                <TextBox x:Name="StartupRecentBox" Height="28" VerticalContentAlignment="Center" Padding="6" Width="80"
                         HorizontalAlignment="Left"
                         ToolTip="填 0：开软件时不翻译任何历史消息，避免一次灌几百条给 AI。填 20：每个频道只翻最近 20 条。"/>
                <TextBlock Text="快捷用语（每行一条，显示在手动条最上方）" Foreground="#FF68748F" Margin="0,12,0,4"/>
                <TextBox x:Name="QuickPhrasesBox" Height="72" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" Padding="6"
                         ToolTip="一行一条；想默认留空就整个清空。点快捷用语时会把内容填进输入框并复制到剪贴板"/>
                <TextBlock Text="保留对话条数" Foreground="#FF68748F" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="HistoryBox" Grid.Column="0" Height="28" VerticalContentAlignment="Center" Padding="6"/>
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FF8A93A8" FontSize="12"
                               Text="超出后自动丢弃最早的对话"/>
                </Grid>

                <TextBlock Text="提示词文件（可自己改术语译名）" Foreground="#FF68748F" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PromptPathText" Grid.Column="0" Foreground="#FF8A93A8" FontSize="12" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="打开提示词" Height="24" Padding="10,0" Margin="8,0,0,0" Click="OpenPromptButton_Click"/>
                </Grid>

                <TextBlock Text="连不上游戏 / 出问题时：先开游戏进角色、点过开始翻译，再点下面这个，复制出来的文字直接发给作者" Foreground="#FF68748F" Margin="0,12,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DiagButton" Content="复制诊断信息" Height="26" Padding="12,0" Click="ExportDiagnostics_Click"
                            Background="#FF2F6BFF" Foreground="White" BorderThickness="0"/>
                    <TextBlock x:Name="DiagStatus" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#FF8A93A8"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#FFEFF3FA" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="HelpText" Foreground="#FF4C5872" FontSize="12" TextWrapping="Wrap" LineHeight="19"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="关注作者B站" Width="110" Height="30" Click="Bili_Click"
                        Background="#FFFDF0F3" Foreground="#FFFB7299" BorderBrush="#FFFB7299" BorderThickness="1"
                        ToolTip="打开作者的 B站 主页"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Width="90" Height="30" Click="Save_Click" Background="#FF2F6BFF" Foreground="White" BorderThickness="0"/>
                <Button Content="取消" Width="90" Height="30" Margin="8,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
